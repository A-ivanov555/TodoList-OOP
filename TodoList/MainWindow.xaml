
<Window x:Class="TodoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TodoList.Models"
        Title="Мои задачи"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>

        <!-- Основная кнопка -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Второстепенная кнопка -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Поля ввода -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"
                    Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28,24,28,26">

        <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА ПРИЛОЖЕНИЯ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Мои задачи"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MainTextBrush}"/>

                <TextBlock Text="Все твои дела в одном месте"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="ThemeToggleButton"
                        Content="☾ Тёмная тема"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,12,0"
                        Click="ThemeToggleButton_Click"/>

                <Button Content="+ Новая задача"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewTaskButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ -->
            <Border x:Name="TasksContainer"
                    Grid.Column="0"
                    Margin="0"
                    CornerRadius="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="1"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и поиск -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Все задачи"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MainTextBrush}"/>

                            <TextBlock x:Name="TaskCountTextBlock"
                                       Text="(0)"
                                       Margin="9,3,0,0"
                                       FontSize="15"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>

                        <!-- Поле появляется при нажатии на лупу -->
                        <Grid x:Name="SearchPanel"
                              Grid.Column="1"
                              Width="220"
                              Margin="0,0,9,0"
                              Visibility="Collapsed">

                            <TextBox x:Name="SearchTextBox"
                                     Style="{StaticResource InputStyle}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>

                            <TextBlock Text="Найти задачу..."
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Text, ElementName=SearchTextBox}"
                                                Value="">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Лупа -->
                        <Button Grid.Column="2"
                                Width="42"
                                Height="42"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="0"
                                ToolTip="Поиск задач"
                                Click="SearchToggleButton_Click">
                            <Grid Width="22" Height="22">
                                <Ellipse Width="13"
                                         Height="13"
                                         Margin="2,2,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Stroke="{DynamicResource MainTextBrush}"
                                         StrokeThickness="2"/>

                                <Line X1="14"
                                      Y1="14"
                                      X2="20"
                                      Y2="20"
                                      Stroke="{DynamicResource MainTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Карточки задач -->
                    <ListBox x:Name="TasksListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="TasksListBox_SelectionChanged">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,11"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder"
                                                    Padding="17"
                                                    CornerRadius="13"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderColorBrush}"
                                                    BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="CardBorder"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter TargetName="CardBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter TargetName="CardBorder"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="87">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Универсальная иконка задачи -->
                                    <Border Width="43"
                                            Height="43"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="✓"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>

                                    <!-- Название и описание -->
                                    <StackPanel Grid.Column="1"
                                                Margin="0,2,12,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MainTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,8,0,0"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>

                                    <!-- Статус и срок -->
                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right">

                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="● Не начата"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MutedTextBrush}"/>

                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding Status}"
                                                            Value="{x:Static models:TodoStatus.InProgress}">
                                                            <Setter Property="Text"
                                                                    Value="● В процессе"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>

                                                        <DataTrigger
                                                            Binding="{Binding Status}"
                                                            Value="{x:Static models:TodoStatus.Completed}">
                                                            <Setter Property="Text"
                                                                    Value="✓ Выполнена"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding DueDate, StringFormat='Срок: {0:dd.MM.yyyy}'}"
                                                   Margin="0,18,0,0"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ПРАВАЯ ПАНЕЛЬ -->
            <Border x:Name="RightPanelContainer"
                    Grid.Column="1"
                    Width="0"
                    Visibility="Collapsed"
                    Opacity="0"
                    ClipToBounds="True"
                    CornerRadius="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="1"
                    Padding="25">
                <Border.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="7"/>
                    </Style>
                </Border.Resources>

                <Grid>

                    <!-- Ничего не выбрано -->
                    <StackPanel x:Name="EmptyPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Выбери задачу"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MainTextBrush}"/>

                        <TextBlock Text="Нажми на карточку слева,&#10;чтобы увидеть подробности"
                                   Margin="0,12,0,0"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>

                    <!-- Подробности -->
                    <ScrollViewer x:Name="DetailsPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="0,0,11,0">

                            <Grid Height="34">
                                <TextBlock Text="ПОДРОБНОСТИ"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>

                                <Button Content="✕"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Закрыть подробности"
                                        Click="CloseDetailsButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="DetailTitleTextBlock"
                                       Margin="0,25,0,16"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MainTextBrush}"/>

                            <TextBlock x:Name="DetailDescriptionTextBlock"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <Separator Margin="0,28,0,18"
                                       Background="{DynamicResource BorderColorBrush}"/>

                            <TextBlock Text="Статус"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <TextBlock x:Name="DetailStatusTextBlock"
                                       Margin="0,6,0,20"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}"/>

                            <TextBlock Text="Приоритет"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <TextBlock x:Name="DetailPriorityTextBlock"
                                       Margin="0,6,0,20"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}"/>

                            <TextBlock Text="Дата создания"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <TextBlock x:Name="DetailCreatedTextBlock"
                                       Margin="0,6,0,20"
                                       FontSize="15"
                                       Foreground="{DynamicResource MainTextBrush}"/>

                            <TextBlock Text="Срок выполнения"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <TextBlock x:Name="DetailDueDateTextBlock"
                                       Margin="0,6,0,25"
                                       FontSize="15"
                                       Foreground="{DynamicResource MainTextBrush}"/>

                            <Button Content="✎  Редактировать"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,8,0,10"
                                    Click="EditTaskButton_Click"/>

                            <Button Content="Удалить задачу"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Click="DeleteTaskButton_Click"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Форма создания и редактирования -->
                    <ScrollViewer x:Name="EditorPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="0,0,14,0">

                            <TextBlock x:Name="EditorHeadingTextBlock"
                                       Text="Новая задача"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MainTextBrush}"/>

                            <TextBlock Text="Название"
                                       Margin="0,24,0,7"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <TextBox x:Name="EditTitleTextBox"
                                     Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Описание"
                                       Margin="0,19,0,7"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <TextBox x:Name="EditDescriptionTextBox"
                                     Style="{StaticResource InputStyle}"
                                     Height="105"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Срок выполнения"
                                       Margin="0,19,0,7"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <DatePicker x:Name="EditDueDatePicker"/>

                            <TextBlock Text="Приоритет"
                                       Margin="0,19,0,7"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <ComboBox x:Name="EditPriorityComboBox"
                                      SelectedIndex="1"
                                      Padding="7">
                                <ComboBoxItem Content="Низкий"/>
                                <ComboBoxItem Content="Средний"/>
                                <ComboBoxItem Content="Высокий"/>
                            </ComboBox>

                            <TextBlock Text="Статус"
                                       Margin="0,19,0,7"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <ComboBox x:Name="EditStatusComboBox"
                                      SelectedIndex="0"
                                      Padding="7">
                                <ComboBoxItem Content="Не начата"/>
                                <ComboBoxItem Content="В процессе"/>
                                <ComboBoxItem Content="Выполнена"/>
                            </ComboBox>

                            <Button Content="Сохранить задачу"
                                    Margin="0,28,0,10"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveTaskButton_Click"/>

                            <Button Content="Отмена"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CancelEditButton_Click"/>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
